# Shared / documentation. Copy values into backend/.env and frontend/.env as needed.

# Backend
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/trustreceivable
USE_MEMORY_DB=true
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
STORAGE_DIR=./uploads
STORAGE_URL=http://localhost:4000/uploads
MAX_UPLOAD_MB=10

# Blockchain (Hardhat local by default)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_NETWORK_NAME=hardhat
# First Hardhat account — local demo only, never a real mainnet key
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=
# If Hardhat is down, backend uses labeled development mock mode
BLOCKCHAIN_MOCK_FALLBACK=true

# Optional future integrations (unused in MVP)
AI_API_KEY=
GSTN_API_KEY=
TRED_API_KEY=

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/api
VITE_APP_NAME=TrustReceivable
